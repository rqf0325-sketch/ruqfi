      <Item class="RemoteFunction" referent="5">
        <Properties>
          <string name="Name">Carry</string>
        </Properties>
      </Item>
      <Item class="RemoteFunction" referent="6">
        <Properties>
          <string name="Name">SendMessage</string>
        </Properties>
      </Item>
      <Item class="RemoteEvent" referent="7">
        <Properties>
          <string name="Name">Notify</string>
        </Properties>
      </Item>
    </Item>
  </Item>
</roblox>