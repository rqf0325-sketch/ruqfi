<roblox version="4">
  <Item class="LocalScript" referent="0">
    <Properties>
      <string name="Name">ScooterAnimator</string>
      <string name="Source"><![CDATA[--[[
	Scooter — animator (StarterPlayer > StarterPlayerScripts > ScooterAnimator)

	Animates every player riding a scooter, on this client: the rider's
	body (Pose), the scooter's steering, wheels, lean and tricks (Motion),
	the lights and the sounds. No uploaded animations are needed.

	Motor6D.Transform doesn't replicate, so every client animates everyone
	from what does replicate (position, velocity, humanoid state). Written in
	PreSimulation, after Roblox's own animations, so it replaces the walk
	animation while riding and hands the body back as soon as it stops.

	Also plays other riders' horns (the tool's "Honk" attribute, set by
	ScooterServer; the rider's own client plays theirs itself).

	Cost: the body pose is only worked out for riders on screen and within
	CULL_DISTANCE (plus this player's own). The rest still get the cheap
	part: wheels, steering, lights and sounds.
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Motion = require(script:WaitForChild("Motion"))
local Pose = require(script:WaitForChild("Pose"))

local CULL_DISTANCE = 250 -- riders further away keep the scooter but not the pose
local SCREEN_MARGIN = 0.25 -- share of the screen size a rider may be outside it and still get posed

local localPlayer = Players.LocalPlayer
local IDENTITY = CFrame.new()

local OFF_STATES = {
	[Enum.HumanoidStateType.Climbing] = true,
	[Enum.HumanoidStateType.Swimming] = true,
	[Enum.HumanoidStateType.Seated] = true,
	[Enum.HumanoidStateType.Dead] = true,
	[Enum.HumanoidStateType.PlatformStanding] = true,
	[Enum.HumanoidStateType.Physics] = true,
}
local AIR_STATES = {
	[Enum.HumanoidStateType.Freefall] = true,
	[Enum.HumanoidStateType.Jumping] = true,
	[Enum.HumanoidStateType.FallingDown] = true,
}

local riders = {} -- character -> rider

local function scooterOf(character)
	for _, child in character:GetChildren() do
		if child:IsA("Tool") and child:GetAttribute("Scooter") then
			return child
		end
	end
	return nil
end

local function motor(parent, name)
	local joint = parent and parent:FindFirstChild(name)
	return if joint and joint:IsA("Motor6D") then joint else nil
end

local function position(parent, name)
	local attachment = parent:FindFirstChild(name)
	return if attachment and attachment:IsA("Attachment") then attachment.Position else nil
end

local function makeSound(parent, id, looped, volume, reach)
	if type(id) ~= "string" or id == "" then
		return nil
	end
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Looped = looped
	sound.Volume = volume
	sound.RollOffMaxDistance = reach or 80
	sound.Parent = parent
	if looped then
		sound:Play()
	end
	return sound
end

-- The scooter's measurements, as it is scaled right now (joints and
-- attachments scale with Model:ScaleTo, attributes don't).
local function readScooter(body)
	local root = body:FindFirstChild("Root")
	local steerHub = body:FindFirstChild("SteerHub")
	local steer, rearSpin = motor(root, "Steer"), motor(root, "RearSpin")
	local frontSpin = motor(steerHub, "FrontSpin")
	if not (steer and rearSpin and frontSpin) then
		return nil
	end
	local anchors, grips = {}, {}
	for _, name in { "Kick", "KickEnd" } do
		anchors[name] = position(root, name)
		if not anchors[name] then
			return nil
		end
	end
	grips.Left, grips.Right = position(steerHub, "LeftGrip"), position(steerHub, "RightGrip")
	if not (grips.Left and grips.Right) then
		return nil
	end
	local scale = body:GetScale()
	return {
		scale = scale,
		deckHeight = (body:GetAttribute("DeckHeight") or 0.5) * scale,
		wheelRadius = (body:GetAttribute("WheelRadius") or 0.34) * scale,
		wheelbase = ((steer.C0 * steer.C1:Inverse() * frontSpin.C0).Position - rearSpin.C0.Position).Magnitude,
		steerC0 = steer.C0,
		steerC1 = steer.C1,
		anchors = anchors,
		grips = grips,
	}
end

local function start(character, tool)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local rootPart = humanoid and humanoid.RootPart
	local body = tool:FindFirstChild("Body")
	local root = body and body:FindFirstChild("Root")
	local steerHub = body and body:FindFirstChild("SteerHub")
	if not (rootPart and root and steerHub) then
		return nil
	end
	local mount, steer = motor(root, "Mount"), motor(root, "Steer")
	local frontSpin, rearSpin = motor(steerHub, "FrontSpin"), motor(root, "RearSpin")
	local scooter = readScooter(body)
	if not (mount and scooter) then
		return nil
	end

	local settingsModule = tool:FindFirstChild("Settings")
	local ok, settings = pcall(require, settingsModule)
	if not ok or type(settings) ~= "table" then
		settings = {}
	end

	local rig = Pose.rig(character)
	local parts = {}
	for _, part in body:GetDescendants() do
		if part:IsA("BasePart") then
			table.insert(parts, part)
		end
	end
	local lamp = body:FindFirstChild("Headlamp", true)

	local rider = {
		character = character,
		tool = tool,
		body = body,
		humanoid = humanoid,
		rootPart = rootPart,
		settings = settings,
		rig = rig,
		motion = Motion.new(scooter, settings, rig and rig.kind),
		mount = mount,
		steer = steer,
		frontSpin = frontSpin,
		rearSpin = rearSpin,
		parts = parts,
		lamp = lamp,
		beam = lamp and lamp:FindFirstChildWhichIsA("SpotLight"),
		underglow = body:FindFirstChild("Underglow", true),
		hidden = false,
		lights = nil,
		isLocal = character == localPlayer.Character,
		honk = tool:GetAttribute("Honk"),
		pose = {},
	}
	if settings.Sounds ~= false then
		rider.windSound = makeSound(root, settings.WindSound, true, 0)
		rider.rollSound = makeSound(root, settings.RollSound, true, 0)
		rider.kickSound = makeSound(root, settings.KickSound, false, 0.35)
	end
	if not rider.isLocal then
		rider.hornSound = makeSound(root, settings.HornSound, false, settings.HornVolume or 1, 150)
	end
	return rider
end

local function setHidden(rider, hidden)
	if rider.hidden == hidden then
		return
	end
	rider.hidden = hidden
	for _, part in rider.parts do
		part.LocalTransparencyModifier = if hidden then 1 else 0
	end
	rider.lights = nil -- re-check
end

local function lightsWanted(rider)
	if rider.hidden then
		return false
	end
	local mode = rider.settings.Lights
	if mode == nil or mode == "Auto" then
		local time = Lighting.ClockTime
		return time < 6.3 or time > 17.7
	end
	return mode == true
end

local function updateLights(rider)
	local on = lightsWanted(rider)
	local glow = on and rider.settings.Underglow ~= false and rider.body:GetAttribute("HasUnderglow") ~= false
	local key = (if on then 1 else 0) + (if glow then 2 else 0)
	if rider.lights == key then
		return
	end
	rider.lights = key
	if rider.beam then
		rider.beam.Enabled = on
	end
	if rider.lamp then
		rider.lamp.Material = if on then Enum.Material.Neon else Enum.Material.SmoothPlastic
	end
	if rider.underglow then
		rider.underglow.Enabled = glow
	end
end

-- The default footstep loop would keep playing while rolling.
local function muteFootsteps(rider, muted)
	local running = rider.rootPart:FindFirstChild("Running")
	if not (running and running:IsA("Sound")) then
		return
	end
	if muted then
		if rider.footsteps == nil then
			rider.footsteps = { sound = running, volume = running.Volume }
		end
		running.Volume = 0
	elseif rider.footsteps then
		rider.footsteps.sound.Volume = rider.footsteps.volume
		rider.footsteps = nil
	end
end

local function quiet(rider)
	for _, sound in { rider.windSound, rider.rollSound } do
		sound.Volume = 0
	end
end

local function finish(rider)
	muteFootsteps(rider, false)
	for _, sound in { rider.windSound, rider.rollSound, rider.kickSound, rider.hornSound } do
		sound:Destroy()
	end
	setHidden(rider, false)
	for _, joint in { rider.mount, rider.steer, rider.frontSpin, rider.rearSpin } do
		joint.Transform = IDENTITY
	end
	if rider.beam then
		rider.beam.Enabled = false
	end
	if rider.underglow then
		rider.underglow.Enabled = false
	end
end

-- Worth working out the pose: on screen (with a margin) and not too far away.
local function inView(camera, position)
	if not camera then
		return true
	end
	local offset = camera.CFrame.Position - position
	if offset.Magnitude > CULL_DISTANCE then
		return false
	end
	if offset.Magnitude < 12 then
		return true
	end
	local point = camera:WorldToViewportPoint(position)
	local size = camera.ViewportSize
	local margin = SCREEN_MARGIN * math.max(size.X, size.Y)
	return point.Z > 0 and point.X > -margin and point.X < size.X + margin
		and point.Y > -margin and point.Y < size.Y + margin
end

local function update(rider, dt, camera)
	local humanoid, rootPart = rider.humanoid, rider.rootPart
	if rider.mount.Part0 ~= rootPart then
		return -- equipped, but not joined to the rider yet
	end

	local honk = rider.tool:GetAttribute("Honk")
	if honk ~= rider.honk then
		rider.honk = honk
		if rider.hornSound then
			rider.hornSound.TimePosition = 0
			rider.hornSound:Play()
		end
	end

	-- Rescaled for a new rider size (the server's ScaleTo can arrive after this rider started).
	if math.abs(rider.body:GetScale() - rider.motion.scooter.scale) > 1e-3 then
		local scooter = readScooter(rider.body)
		if scooter then
			rider.motion.scooter = scooter
		end
	end

	local state = humanoid:GetState()
	local off = OFF_STATES[state] or humanoid.Sit
	setHidden(rider, off)
	updateLights(rider)
	if off then
		quiet(rider)
		muteFootsteps(rider, false)
		return
	end
	muteFootsteps(rider, true)

	local result = rider.motion:update(dt, {
		rootCFrame = rootPart.CFrame,
		velocity = rootPart.AssemblyLinearVelocity,
		airborne = AIR_STATES[state] == true,
		gravity = workspace.Gravity,
		mountC0 = rider.mount.C0,
	})
	rider.mount.Transform = result.mount
	rider.steer.Transform = result.steer
	rider.frontSpin.Transform = result.wheel
	rider.rearSpin.Transform = result.wheel

	-- Avatar changes (e.g. a new HumanoidDescription) rebuild the joints.
	if rider.rig and not rider.rig.root.Parent then
		rider.rig = Pose.rig(rider.character)
	end
	if rider.rig and (rider.isLocal or inView(camera, rootPart.Position)) then
		for joint, transform in Pose.solve(rider.rig, rootPart.CFrame, result.targets, rider.pose) do
			joint.Transform = transform
		end
	end

	local speed = result.speed
	local grounded = rider.motion.grounded
	if rider.windSound then
		rider.windSound.Volume = math.clamp((speed - 10) / 25, 0, 1) * 0.3
		rider.windSound.PlaybackSpeed = 0.8 + speed / 80
	end
	if rider.rollSound then
		rider.rollSound.Volume = if grounded then math.clamp(speed / 20, 0, 1) * 0.5 else 0
		rider.rollSound.PlaybackSpeed = 0.7 + speed / 60
	end
	if rider.kickSound and (result.kicked or result.landed) then
		rider.kickSound.PlaybackSpeed = if result.landed then 0.8 else 1 + (math.random() - 0.5) * 0.15
		rider.kickSound:Play()
	end
end

RunService.PreSimulation:Connect(function(dt)
	local camera = workspace.CurrentCamera
	local seen = {}
	for _, player in Players:GetPlayers() do
		local character = player.Character
		local tool = character and scooterOf(character)
		if not tool then
			continue
		end
		local rider = riders[character]
		if rider and rider.tool ~= tool then
			finish(rider)
			rider = nil
		end
		if not rider then
			rider = start(character, tool)
			riders[character] = rider
		end
		if rider and not rider.broken then
			seen[character] = true
			local ok, err = pcall(update, rider, dt, camera)
			if not ok then
				rider.broken = true
				warn(`ScooterAnimator: stopped animating {character.Name}: {err}`)
			end
		elseif rider then
			seen[character] = true
		end
	end
	for character, rider in riders do
		if not seen[character] then
			finish(rider)
			riders[character] = nil
		end
	end
end)
]]></string>
    </Properties>
    <Item class="ModuleScript" referent="1">
      <Properties>
        <string name="Name">Pose</string>
        <string name="Source"><![CDATA[--[[
	Scooter — rider pose (ScooterAnimator > Pose)

	Works out Motor6D.Transform for a rider's joints so the hands hold the
	grips and the feet stand on the deck (or kick the ground), for R6 and
	R15 rigs of any size. Pure maths on the rig's own C0/C1 values: nothing
	is read from part positions, so it doesn't lag a frame behind, and it
	can be tested outside Roblox (tools/test-scooter-pose.luau).

	  local rig = Pose.rig(character)                  -- nil if the rig isn't R6/R15
	  local transforms = Pose.solve(rig, rootCFrame, targets[, reuse])
	  for motor, transform in transforms do motor.Transform = transform end

	targets:
	  lean, roll, dip, spin    body posture (radians / studs)
	  ground                   point the body rolls around, in the root part's space
	  twist                    radians the shoulders turn with the handlebar
	  hands.Left/Right         world positions of the grips
	  feet.Left/Right          world positions for the soles
	  slide.Left/Right         R6 only: rigid legs reach the deck by sliding the
	                           foot along this direction instead of floating
	  facing                   world CFrame whose rotation the feet and head follow
	  headPitch                radians the head looks down
]]

local Pose = {}

local IDENTITY = CFrame.new()
local DOWN = Vector3.new(0, -1, 0)

local function rotation(cframe)
	return cframe - cframe.Position
end

-- Smallest rotation turning unit vector a into unit vector b.
local function between(a, b)
	local dot = math.clamp(a:Dot(b), -1, 1)
	local axis = a:Cross(b)
	if axis.Magnitude < 1e-6 then
		if dot > 0 then
			return IDENTITY
		end
		local other = if math.abs(a.X) < 0.9 then Vector3.new(1, 0, 0) else Vector3.new(0, 1, 0)
		return CFrame.fromAxisAngle(a:Cross(other).Unit, math.pi)
	end
	return CFrame.fromAxisAngle(axis.Unit, math.acos(dot))
end

-- Part1 = parent * C0 * Transform * C1^-1

-- Moves Part1 by `offset`, given in Part0's space (a rigid transform).
local function shift(out, motor, parent, offset)
	out[motor] = motor.C0:Inverse() * offset * motor.C0
	return parent * offset * motor.C0 * motor.C1:Inverse()
end

-- Turns the joint so `point` (in Part1's space) points at `target`.
local function aim(out, motor, parent, point, target)
	local frame = parent * motor.C0
	local c1Inverse = motor.C1:Inverse()
	local from = c1Inverse * point
	local to = frame:PointToObjectSpace(target)
	local transform = IDENTITY
	if from.Magnitude > 1e-4 and to.Magnitude > 1e-4 then
		transform = between(from.Unit, to.Unit)
	end
	out[motor] = transform
	return frame * transform * c1Inverse
end

-- Turns the joint so Part1 has the rotation of `goal` (blended by `weight`).
local function orient(out, motor, parent, goal, weight)
	local transform = rotation(parent * motor.C0):Inverse() * rotation(goal) * rotation(motor.C1)
	if weight < 1 then
		transform = IDENTITY:Lerp(transform, weight)
	end
	out[motor] = transform
	return parent * motor.C0 * transform * motor.C1:Inverse()
end

-- Two joints (shoulder + elbow, hip + knee): `point` in the lower part's
-- space reaches `target`, the middle joint bends towards `pole`.
local function twoBone(out, upper, lower, parent, point, target, pole)
	local start = (parent * upper.C0).Position
	local middle = lower.C0.Position -- middle joint, in the upper part's space
	local a = (middle - upper.C1.Position).Magnitude
	local b = (point - lower.C1.Position).Magnitude
	local toTarget = target - start
	local direction = if toTarget.Magnitude > 1e-4 then toTarget.Unit else DOWN
	local distance = math.clamp(toTarget.Magnitude, math.abs(a - b) + 1e-3, a + b - 1e-3)
	local cosine = math.clamp((a * a + distance * distance - b * b) / (2 * a * distance), -1, 1)
	local bend = pole - direction * pole:Dot(direction)
	if bend.Magnitude < 1e-4 then
		bend = direction:Cross(Vector3.new(1, 0, 0))
	end
	bend = bend.Unit
	local joint = start + direction * (a * cosine) + bend * (a * math.sqrt(1 - cosine * cosine))
	local upperFrame = aim(out, upper, parent, middle, joint)
	local lowerFrame = aim(out, lower, upperFrame, point, start + direction * distance)
	return upperFrame, lowerFrame
end

-- A rigid limb (R6) can't shorten, so a target closer than the limb's
-- length is moved along `slide` until the limb exactly reaches it.
local function reach(pivot, target, length, slide)
	local offset = target - pivot
	if offset.Magnitude >= length or not slide then
		return target
	end
	local along = offset:Dot(slide)
	local distance = -along + math.sqrt(math.max(0, along * along - (offset:Dot(offset) - length * length)))
	return target + slide * distance
end

local function motorIn(character, partName, jointName)
	local part = character:FindFirstChild(partName)
	local joint = part and part:FindFirstChild(jointName)
	return if joint and joint:IsA("Motor6D") then joint else nil
end

-- Reads the rig's joints. Returns nil if anything the pose needs is missing.
function Pose.rig(character)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	if not humanoid then
		return nil
	end

	if humanoid.RigType == Enum.HumanoidRigType.R6 then
		local rig = {
			kind = "R6",
			root = motorIn(character, "HumanoidRootPart", "RootJoint"),
			neck = motorIn(character, "Torso", "Neck"),
			arms = {},
			legs = {},
		}
		if not (rig.root and rig.neck) then
			return nil
		end
		for _, side in { "Left", "Right" } do
			local arm = character:FindFirstChild(side .. " Arm")
			local leg = character:FindFirstChild(side .. " Leg")
			local shoulder = motorIn(character, "Torso", side .. " Shoulder")
			local hip = motorIn(character, "Torso", side .. " Hip")
			if not (arm and leg and shoulder and hip) then
				return nil
			end
			-- The bar sits in the lower part of the arm block (its "fist").
			rig.arms[side] = { joint = shoulder, point = Vector3.new(0, -arm.Size.Y * 0.3, 0) }
			rig.legs[side] = { joint = hip, point = Vector3.new(0, -leg.Size.Y / 2, 0) }
		end
		-- Hips (Torso space) -> the pivot the body leans around (root space).
		local hips = (rig.legs.Left.joint.C0.Position + rig.legs.Right.joint.C0.Position) / 2
		rig.pivot = rig.root.C0 * rig.root.C1:Inverse() * hips
		return rig
	end

	local rig = {
		kind = "R15",
		root = motorIn(character, "LowerTorso", "Root"),
		waist = motorIn(character, "UpperTorso", "Waist"),
		neck = motorIn(character, "Head", "Neck"),
		arms = {},
		legs = {},
	}
	if not (rig.root and rig.waist and rig.neck) then
		return nil
	end
	for _, side in { "Left", "Right" } do
		local hand = character:FindFirstChild(side .. "Hand")
		local foot = character:FindFirstChild(side .. "Foot")
		local arm = {
			upper = motorIn(character, side .. "UpperArm", side .. "Shoulder"),
			lower = motorIn(character, side .. "LowerArm", side .. "Elbow"),
			wrist = motorIn(character, side .. "Hand", side .. "Wrist"),
		}
		local leg = {
			upper = motorIn(character, side .. "UpperLeg", side .. "Hip"),
			lower = motorIn(character, side .. "LowerLeg", side .. "Knee"),
			ankle = motorIn(character, side .. "Foot", side .. "Ankle"),
		}
		if not (hand and foot and arm.upper and arm.lower and arm.wrist and leg.upper and leg.lower and leg.ankle) then
			return nil
		end
		-- Grip point of the hand and sole of the foot, in the lower arm / lower leg's space.
		local grip = hand:FindFirstChild(side .. "GripAttachment")
		local gripPosition = if grip and grip:IsA("Attachment") then grip.CFrame.Position else Vector3.new()
		arm.point = arm.wrist.C0 * arm.wrist.C1:Inverse() * gripPosition
		-- The leg's IK moves the ankle; the foot is then turned flat, so the
		-- ankle goes where the sole's target is plus the ankle's height above the sole.
		leg.point = leg.ankle.C0.Position
		leg.ankleAboveSole = leg.ankle.C1.Position - Vector3.new(0, -foot.Size.Y / 2, 0)
		rig.arms[side] = arm
		rig.legs[side] = leg
	end
	local hips = (rig.legs.Left.upper.C0.Position + rig.legs.Right.upper.C0.Position) / 2
	rig.pivot = rig.root.C0 * rig.root.C1:Inverse() * hips
	return rig
end

-- Body posture in root space: dip down, spin and roll around the ground
-- under the rider (like the scooter), then lean around the hips.
local function posture(rig, targets, leanShare, twist)
	local ground = CFrame.new(targets.ground or Vector3.new())
	local hips = CFrame.new(rig.pivot)
	return CFrame.new(0, -(targets.dip or 0), 0)
		* ground
		* CFrame.Angles(0, targets.spin or 0, 0)
		* CFrame.Angles(0, 0, targets.roll or 0)
		* ground:Inverse()
		* hips
		* CFrame.Angles(0, twist, 0)
		* CFrame.Angles(-(targets.lean or 0) * leanShare, 0, 0)
		* hips:Inverse()
end

local SIDES = { Left = -1, Right = 1 }

-- `out` (optional) is reused between frames to save allocating a table:
-- every call writes the same joints.
function Pose.solve(rig, rootCFrame, targets, out)
	out = out or {}
	local facing = rotation(targets.facing or rootCFrame)
	local head = facing * CFrame.Angles(-(targets.headPitch or 0), 0, 0)

	if rig.kind == "R6" then
		local torso = shift(out, rig.root, rootCFrame, posture(rig, targets, 1, targets.twist or 0))
		for side, arm in rig.arms do
			aim(out, arm.joint, torso, arm.point, targets.hands[side])
		end
		for side, leg in rig.legs do
			local pivot = (torso * leg.joint.C0).Position
			local length = (leg.joint.C1:Inverse() * leg.point).Magnitude
			local target = reach(pivot, targets.feet[side], length, targets.slide and targets.slide[side])
			aim(out, leg.joint, torso, leg.point, target)
		end
		orient(out, rig.neck, torso, head, 0.7)
		return out
	end

	-- R15: lean split between the hips and the waist for a rounder back.
	local lowerTorso = shift(out, rig.root, rootCFrame, posture(rig, targets, 0.55, 0))
	local waistPivot = CFrame.new(rig.waist.C0.Position)
	local bend = waistPivot
		* CFrame.Angles(0, targets.twist or 0, 0)
		* CFrame.Angles(-(targets.lean or 0) * 0.45, 0, 0)
		* waistPivot:Inverse()
	local upperTorso = shift(out, rig.waist, lowerTorso, bend)

	for side, arm in rig.arms do
		-- Elbows bend outwards, backwards and a little down.
		local pole = facing:VectorToWorldSpace(Vector3.new(SIDES[side] * 0.6, -0.4, 1))
		twoBone(out, arm.upper, arm.lower, upperTorso, arm.point, targets.hands[side], pole)
		out[arm.wrist] = IDENTITY
	end
	for side, leg in rig.legs do
		-- Knees bend forwards and slightly outwards.
		local pole = facing:VectorToWorldSpace(Vector3.new(SIDES[side] * 0.25, 0, -1))
		local ankle = targets.feet[side] + facing:VectorToWorldSpace(leg.ankleAboveSole)
		local _, lowerLeg = twoBone(out, leg.upper, leg.lower, lowerTorso, leg.point, ankle, pole)
		orient(out, leg.ankle, lowerLeg, facing, 1)
	end
	orient(out, rig.neck, upperTorso, head, 0.7)
	return out
end

return Pose
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="2">
      <Properties>
        <string name="Name">Motion</string>
        <string name="Source"><![CDATA[--[[
	Scooter — ride motion (ScooterAnimator > Motion)

	Turns how a rider moves (velocity, turning, jumping) into the scooter's
	joint transforms and the targets for Pose: kicking while speeding up,
	cruising with both feet on the deck, one foot down when stopped, leaning
	into turns, and a tailwhip / 360 spin when jumping at speed. Pure maths,
	so every client computes the same thing from replicated movement, and it
	can be tested outside Roblox (tools/test-scooter-pose.luau).

	  local motion = Motion.new(scooter, settings, "R6")
	  local result = motion:update(dt, {
	      rootCFrame = HumanoidRootPart.CFrame,
	      velocity = HumanoidRootPart.AssemblyLinearVelocity,
	      airborne = true/false,
	      gravity = workspace.Gravity,
	      mountC0 = Mount.C0,
	  })
	  result.mount / .steer / .wheel   Transforms for Mount, Steer, FrontSpin + RearSpin
	  result.targets                   for Pose.solve
	  result.kicked / .landed          for sounds
]]

local Motion = {}
Motion.__index = Motion

local KICK_RATE = 1.5 -- kicks per second
local PUSH_SHARE = 0.5 -- part of each kick the foot spends pushing along the ground
local TRICK_TIME = 0.5 -- seconds for a full tailwhip / spin
local STOP_FOOT_Z = 0.1 -- where the free foot rests on the ground when stopped
-- R15 feet, relative to the ground under the rider's root part (R6 keeps its feet under its hips).
local R15_FRONT_FOOT = Vector3.new(-0.3, 0, -0.7)
local R15_BACK_FOOT = Vector3.new(0.3, 0, -0.05)

local function smooth(current, target, rate, dt)
	return current + (target - current) * (1 - math.exp(-rate * dt))
end

-- scooter: deckHeight, wheelRadius, wheelbase, steerC0, steerC1, scale
-- (Model:GetScale() of the scooter; body-size distances are scaled with it),
-- anchors (Kick, KickEnd in Root space),
-- grips (Left, Right in SteerHub space). Can be swapped for a new table
-- (motion.scooter = ...) when the scooter is rescaled.
function Motion.new(scooter, settings, rigKind)
	return setmetatable({
		scooter = scooter,
		settings = settings,
		r6 = rigKind == "R6",
		speed = 0,
		accel = 0,
		yaw = nil,
		yawRate = 0,
		steer = 0,
		roll = 0,
		wheel = 0,
		push = 0,
		idle = 1,
		kickHold = 0,
		phase = 0,
		grounded = true,
		airTime = 0,
		land = 0,
		trick = nil,
		tricks = 0,
	}, Motion)
end

function Motion:update(dt, frame)
	local scooter, settings = self.scooter, self.settings
	dt = math.max(dt, 1e-3)

	-- How the rider moves
	local rootCFrame, velocity = frame.rootCFrame, frame.velocity
	local look = Vector3.new(rootCFrame.LookVector.X, 0, rootCFrame.LookVector.Z)
	look = if look.Magnitude > 1e-3 then look.Unit else Vector3.new(0, 0, -1)
	local flat = Vector3.new(velocity.X, 0, velocity.Z)
	local speed = flat.Magnitude
	self.accel = smooth(self.accel, (speed - self.speed) / dt, 5, dt)
	self.speed = speed
	local yaw = math.atan2(-look.X, -look.Z)
	if self.yaw then
		local turned = (yaw - self.yaw + math.pi) % (2 * math.pi) - math.pi
		self.yawRate = smooth(self.yawRate, turned / dt, 10, dt) -- > 0 = turning left
	end
	self.yaw = yaw

	-- Jumps and tricks
	local airborne = frame.airborne
	local landed = false
	if airborne then
		if self.grounded then
			self.airTime = 0
		end
		self.airTime += dt
		-- Decide within the first moments of the jump: for other players the
		-- jump's velocity can arrive a frame after the jumping state.
		local airtime = 2 * math.max(velocity.Y, 0) / frame.gravity
		if not self.trick and self.airTime < 0.15 and settings.Tricks ~= false
			and speed >= (settings.TrickMinSpeed or 16) and airtime > 0.45 then
			self.tricks += 1
			self.trick = {
				kind = if self.tricks % 2 == 1 then "tailwhip" else "spin",
				direction = if self.yawRate < 0 then -1 else 1,
				t = 0,
				duration = math.min(TRICK_TIME, airtime * 0.8),
			}
		end
	elseif not self.grounded then
		self.land = 1
		landed = true
		if self.trick then
			-- Landed early: finish the trick quickly instead of snapping.
			self.trick.duration = math.min(self.trick.duration, self.trick.t + 0.08)
		end
	end
	self.grounded = not airborne
	self.land = math.max(0, self.land - dt / 0.25)

	local whip, spin, tuck = 0, 0, 0
	local trick = self.trick
	if trick then
		trick.t += dt
		local u = math.clamp(trick.t / trick.duration, 0, 1)
		local eased = u * u * (3 - 2 * u)
		if trick.kind == "tailwhip" then
			whip = eased * 2 * math.pi
			tuck = math.sin(math.pi * u)
		else
			spin = eased * 2 * math.pi * trick.direction
			tuck = 0.35 * math.sin(math.pi * u)
		end
		if u >= 1 then
			self.trick = nil
		end
	end

	-- Kicking: while speeding up on the ground
	local moving = speed > 1.5
	if self.grounded and moving and self.accel > 1.5 and not trick then
		self.kickHold = 0.3
	end
	self.kickHold -= dt
	self.push = smooth(self.push, if self.kickHold > 0 then 1 else 0, 8, dt)
	self.idle = smooth(self.idle, if moving or not self.grounded then 0 else 1, 5, dt)
	local before = self.phase
	self.phase = if self.push > 0.02 then (self.phase + dt * KICK_RATE) % 1 else 0
	local kicked = self.push > 0.3 and before < 0.02 and self.phase >= 0.02

	-- Handlebar and lean follow the turn
	local steerTarget = 0
	if speed > 1 then
		steerTarget = math.atan(scooter.wheelbase * self.yawRate / math.max(speed, 4))
	end
	self.steer = smooth(self.steer, math.clamp(steerTarget, -0.6, 0.6), 10, dt)
	local rollTarget = if self.grounded then math.clamp(self.yawRate * speed * 0.012, -0.3, 0.3) else 0
	self.roll = smooth(self.roll, rollTarget, 6, dt)
	self.wheel = (self.wheel + flat:Dot(look) / scooter.wheelRadius * dt) % (2 * math.pi)

	-- Scooter joints. Leaning pivots on the ground under the deck; the
	-- tailwhip turns the deck around the steering axis while the handlebar
	-- stays in the rider's hands.
	local ground = CFrame.new(0, -scooter.deckHeight, 0)
	local lean = ground * CFrame.Angles(0, 0, self.roll) * ground:Inverse()
	local facingTransform = CFrame.Angles(0, spin, 0) * lean
	local mount = facingTransform
	if whip ~= 0 then
		mount = mount * scooter.steerC0 * CFrame.Angles(0, whip, 0) * scooter.steerC0:Inverse()
	end
	local steer = CFrame.Angles(0, self.steer - whip, 0)

	-- Targets for Pose
	local deck = rootCFrame * frame.mountC0 * mount
	local facing = rootCFrame * frame.mountC0 * facingTransform
	local bar = deck * scooter.steerC0 * steer * scooter.steerC1:Inverse()

	-- R6 legs are rigid, so R6 feet stay under the hips (x = ±0.5) and Pose
	-- slides them forward/back to where the legs actually reach. An R6 foot
	-- can't reach the ground from the deck, so its kick swings wider and
	-- further out instead, to read as a push.
	local r6 = self.r6
	local size = scooter.scale or 1
	local anchors = scooter.anchors
	-- R15 stands with the front foot ahead, the back foot behind, around the
	-- point under its root part (which isn't under Root for R15, see Mount.C0).
	local under = Vector3.new(-frame.mountC0.X, 0, -frame.mountC0.Z)
	local left = if r6 then Vector3.new(-0.5, 0, 0) else under + R15_FRONT_FOOT * size
	local right = if r6 then Vector3.new(0.5, 0, 0) else under + R15_BACK_FOOT * size
	local kickStart, kickEnd, kickLift = anchors.Kick + under, anchors.KickEnd + under, 0.55 * size
	if r6 then
		kickStart = Vector3.new(1.15, anchors.Kick.Y, -0.45)
		kickEnd = Vector3.new(1.15, anchors.KickEnd.Y, 1.35)
		kickLift = 0.8
	end
	right = right:Lerp(Vector3.new(kickStart.X, kickStart.Y, STOP_FOOT_Z * size), self.idle)
	local strength = 0
	if self.push > 0.001 then
		local kick
		if self.phase < PUSH_SHARE then
			local u = self.phase / PUSH_SHARE
			kick = kickStart:Lerp(kickEnd, u)
			strength = math.sin(math.pi * u)
		else
			local u = (self.phase - PUSH_SHARE) / (1 - PUSH_SHARE)
			kick = kickEnd:Lerp(kickStart, u * u * (3 - 2 * u)) + Vector3.new(0, kickLift * math.sin(math.pi * u), 0)
		end
		right = right:Lerp(kick, self.push)
	end
	local lift = Vector3.new(0, 0.9 * size * tuck, 0)
	local pushing = self.push * strength

	return {
		mount = mount,
		steer = steer,
		wheel = CFrame.Angles(-self.wheel, 0, 0),
		kicked = kicked,
		landed = landed,
		speed = speed,
		targets = {
			-- R6 arms can't bend either, so R6 leans less to keep its hands on the grips.
			lean = if r6 then 0.1 + 0.08 * pushing + 0.05 * tuck else 0.1 + 0.12 * pushing - 0.08 * self.idle + 0.1 * tuck,
			roll = self.roll,
			twist = self.steer * 0.7,
			ground = (frame.mountC0 * ground).Position,
			-- R6 legs are rigid: a small dip lets them stand a little apart.
			-- R15 keeps its knees soft and bends the standing knee deep enough
			-- in each push for the other foot to reach the ground.
			dip = if r6 then 0.03 + 0.03 * self.land
				else (0.25 + 0.5 * pushing + 0.25 * self.land + 0.15 * tuck) * size,
			spin = spin,
			hands = { Left = bar * scooter.grips.Left, Right = bar * scooter.grips.Right },
			feet = { Left = facing * (left + lift), Right = facing * (right + lift) },
			slide = { Left = facing.LookVector, Right = -facing.LookVector },
			facing = facing,
			headPitch = 0.12,
		},
	}
end

return Motion
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>