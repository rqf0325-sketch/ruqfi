      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RhythmRunner</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/RhythmRunner.lua
--
-- Patch notes (PAUL):
--   • sys "Delay" (used twice by RhythmLibrary) is now run; it used to be ignored
--   • the "circleAccelIdleSpeed" step (speed back to idle after a beat) now exists
--   • level names accept both "Med" and "Medium" (BeatSync sends "Med")
--   • "branch" no longer takes the wrong side when ifTrue is empty
--   • sys "HardResetAll" is handled
--   • OnBeat / OnBar stop while the Control Panel's Sync switch is OFF
local State = require(script.Parent:WaitForChild("AutoLightsState"))

local RhythmRunner = {}
RhythmRunner.__index = RhythmRunner

local LEVEL_RANK = { Low = 1, Med = 2, Medium = 2, High = 3, Insane = 4, Nuclear = 5 }
local function levelRank(name)
	return LEVEL_RANK[tostring(name)] or 1
end

function RhythmRunner.new(Logger, GLAdapter, PyroAdapter)
	return setmetatable({
		Logger = Logger,
		GL = GLAdapter,
		Pyro = PyroAdapter,

		_running = false,
		_current = nil,
		_vars = {},
		_level = "Medium",
		_armed = false,
		_token = 0, -- changes on every Play/Stop so delayed steps of an old preset are dropped

		beatIndex = 0,
		barIndex = 0,
	}, RhythmRunner)
end

function RhythmRunner:SetArmed(v)
	self._armed = v and true or false
end

function RhythmRunner:SetLevel(level)
	self._level = level or self._level
end

function RhythmRunner:IsRunning()
	return self._running
end

function RhythmRunner:Stop()
	self._running = false
	self._current = nil
	self._vars = {}
	self._token += 1
end

function RhythmRunner:_getVar(k)
	return self._vars[k]
end

function RhythmRunner:_setVar(k,v)
	self._vars[k] = v
end

function RhythmRunner:_incVar(k,delta)
	self._vars[k] = (self._vars[k] or 0) + (delta or 1)
end

function RhythmRunner:_toggle(k)
	self._vars[k] = not self._vars[k]
end

function RhythmRunner:_execStep(step)
	if type(step) ~= "table" then return end

	if step.type == "sys" then
		if step.fn == "CleanupPreset" then
			self.GL:CleanupPreset()
		elseif step.fn == "EnsureAllOnBaseline" then
			self.GL:EnsureAllOnBaseline(step.args and step.args[1])
		elseif step.fn == "HardResetAll" then
			self.GL:HardResetAll()
		elseif step.fn == "Delay" then
			-- args = { seconds, step }: run `step` after `seconds`, unless the preset changed
			local seconds = tonumber(step.args and step.args[1]) or 0
			local inner = step.args and step.args[2]
			local token = self._token
			task.delay(seconds, function()
				if self._running and self._token == token then
					self:_execStep(inner)
				end
			end)
		end

	elseif step.type == "gl" then
		self.GL:Run(step.folder, step.fn, step.args)

	elseif step.type == "set" then
		self:_setVar(step.key, step.value)

	elseif step.type == "inc" then
		self:_incVar(step.key, step.delta or 1)

	elseif step.type == "toggle" then
		self:_toggle(step.key)

	elseif step.type == "branch" then
		local list
		if self:_getVar(step.key) then
			list = step.ifTrue
		else
			list = step.ifFalse
		end
		for _,s in ipairs(list or {}) do
			self:_execStep(s)
		end

	elseif step.type == "neonRippleLEDs" then
		-- ripple simple: rotate color per beat
		local colors = step.colors or {}
		local idx = (self:_getVar("_ripple") or 0) + 1
		if #colors == 0 then return end
		if idx > #colors then idx = 1 end
		self:_setVar("_ripple", idx)
		self.GL:Run("LEDs","Color",{colors[idx]})

	elseif step.type == "circleAccelGoboHeads" then
		-- CUSTOM kamu
		local speedSeq = self:_getVar("speedSeq") or {0.006,0.010,0.016,0.024}
		local spreadSeq= self:_getVar("spreadSeq") or {0.12,0.25,0.45,0.65}
		local colorSeq = self:_getVar("colorSeq") or {Color3.new(1,1,1)}

		local si = self:_getVar("speedIndex") or 1
		local gi = self:_getVar("spreadIndex") or 1
		local ci = self:_getVar("colorIndex") or 1

		local spd = speedSeq[si] or speedSeq[#speedSeq]
		local spr = spreadSeq[gi] or spreadSeq[#spreadSeq]
		local col = colorSeq[ci] or colorSeq[#colorSeq]

		self.GL:Run("Heads","MotorSpeed",{spd})
		self.GL:Run("Heads","GoboSpread",{spr})
		self.GL:Run("ALL","Color",{col})

		si += 1; if si > #speedSeq then si = #speedSeq end
		gi += 1; if gi > #spreadSeq then gi = 1 end
		ci += 1; if ci > #colorSeq then ci = 1 end

		self:_setVar("speedIndex", si)
		self:_setVar("spreadIndex", gi)
		self:_setVar("colorIndex", ci)

	elseif step.type == "circleAccelIdleSpeed" then
		-- after a beat the heads slow back down to the idle speed (first entry of speedSeq)
		local speedSeq = self:_getVar("speedSeq") or {0.006}
		self.GL:Run("Heads","MotorSpeed",{speedSeq[1] or 0.006})

	elseif step.type == "pyro" then
		if not self.Pyro then return end
		if step.requireArmed and not self._armed then return end

		local gate = step.gate or {}
		local needLevel = gate.levelAtLeast
		if needLevel and levelRank(self._level) < levelRank(needLevel) then
			return
		end

		-- everyNBeats / everyNBars gate
		if gate.everyNBeats then
			if (self.beatIndex % gate.everyNBeats) ~= 0 then
				return
			end
		end
		if gate.everyNBars then
			if (self.barIndex % gate.everyNBars) ~= 0 then
				return
			end
		end

		-- Fire pyro (optional)
		self.Pyro:Fire(step.device, step.pattern, step.args)

	end
end

function RhythmRunner:Play(preset)
	self:Stop()
	self._running = true
	self._current = preset
	self._vars = {}
	self.beatIndex = 0
	self.barIndex = 0

	-- onEnter
	for _,s in ipairs(preset.onEnter or {}) do
		self:_execStep(s)
	end
end

function RhythmRunner:OnBeat(beatEvent)
	if not self._running or not self._current then return end
	if not State.SyncEnabled() then return end
	beatEvent = beatEvent or {}

	-- NEW: ikut level dari beat event (biar gate levelAtLeast kepake)
	if beatEvent.level then
		self._level = tostring(beatEvent.level)
	end

	self.beatIndex = beatEvent.beatIndex or (self.beatIndex + 1)
	self.barIndex = beatEvent.barIndex or self.barIndex

	for _,s in ipairs(self._current.onBeat or {}) do
		self:_execStep(s)
	end
end

function RhythmRunner:OnBar(barIndex)
	if not self._running or not self._current then return end
	if not State.SyncEnabled() then return end
	self.barIndex = barIndex or self.barIndex
	for _,s in ipairs(self._current.onBar or {}) do
		self:_execStep(s)
	end
end

function RhythmRunner:Exit()
	if not self._running or not self._current then return end
	for _,s in ipairs(self._current.onExit or {}) do
		self:_execStep(s)
	end
	self:Stop()
end

return RhythmRunner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ShowEngine</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/ShowEngine.lua
--
-- Patch notes (PAUL):
--   • a cinematic loop without any wait step froze the server; the loop now yields
--   • MANUAL commands validate folder / fn / args (args must be a table)
--   • PLAY_CINEMATIC / PLAY_RHYTHM / PYRO_RUN ids must be strings
--   • beat payloads without a beatIndex no longer break the pyro dispatch
--   • unused helpers removed
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShowEngine = {}
ShowEngine.__index = ShowEngine

local AutoLights = ReplicatedStorage:WaitForChild("AutoLights")
local Shared = AutoLights:WaitForChild("Shared")
local PresetLibrary = require(Shared:WaitForChild("PresetLibrary"))
local RhythmLibrary = require(Shared:WaitForChild("RhythmLibrary"))
local Palette = require(Shared:WaitForChild("Palette"))

local function now() return os.clock() end

local function deepCopy(t)
	if type(t) ~= "table" then return t end
	local o = {}
	for k,v in pairs(t) do o[k] = deepCopy(v) end
	return o
end

local function exportPalette()
	local out = {}
	for k,v in pairs(Palette) do
		if typeof(v) == "Color3" then
			out[k] = v
		end
	end
	return out
end

-- ===== Pyro preset list (10) =====
local PYRO_PRESETS = {
	-- non-beat sequences
	{ id="PY_01_CO2_BURST",     name="CO2 BURST",        category="CO2",      mode="sequence",
		steps={{device="FPA",pattern="AllHold",args={duration=0.25}}} },

	{ id="PY_02_CO2_WAVE",      name="CO2 WAVE",         category="CO2",      mode="sequence",
		steps={{device="FPA",pattern="WaveL2R",args={interval=0.07}}} },

	{ id="PY_03_FIRE_WALK_L2R", name="FIRE WALK L2R",    category="FIRE",     mode="sequence",
		steps={{device="FPA",pattern="WaveL2R",args={interval=0.09}},
			{wait=0.25},
			{device="FPA",pattern="WaveL2R",args={interval=0.09}} } },

	{ id="PY_04_FIRE_INOUT",    name="FIRE INOUT",       category="FIRE",     mode="sequence",
		steps={{device="FPA",pattern="CenterOut",args={interval=0.10}},
			{wait=0.20},
			{device="FPA",pattern="EdgeIn",args={interval=0.10}} } },

	{ id="PY_05_CONFETTI_BURST",name="CONFETTI BURST",   category="CONFETTI", mode="sequence",
		steps={{device="CONFETTI",pattern="Burst",args={duration=1.2}}} },

	-- beat synced
	{ id="PY_06_CO2_ON_EVERY_BEAT", name="CO2 EVERY BEAT", category="CO2", mode="beat",
		onBeat={device="FPA",pattern="AllHold",args={duration=0.08}, everyNBeats=1} },

	{ id="PY_07_FIRE_ON_BEAT",  name="FIRE ON BEAT",     category="FIRE", mode="beat",
		onBeat={device="FPA",pattern="CenterPunch",args={duration=0.10}, everyNBeats=1} },

	{ id="PY_08_CONFETTI_ON_BAR", name="CONFETTI ON BAR", category="CONFETTI", mode="beat",
		onBar={device="CONFETTI",pattern="Burst",args={duration=1.0}, everyNBars=1} },

	{ id="PY_09_SMOKE_ON_2BEAT", name="SMOKE ON 2BEAT",   category="SMOKE", mode="beat",
		onBeat={device="SMOKE",pattern="Burst",args={duration=1.0}, everyNBeats=2} },

	{ id="PY_10_MEGA_COMBO",    name="MEGA COMBO",       category="MEGA", mode="beat",
		onBar={device="FPA",pattern="CenterOut",args={interval=0.09}, everyNBars=1},
		onBeat={device="SMOKE",pattern="Burst",args={duration=0.8}, everyNBeats=4},
	},
}

local PYRO_BY_ID = {}
for _,p in ipairs(PYRO_PRESETS) do PYRO_BY_ID[p.id] = p end

function ShowEngine.new(deps)
	local self = setmetatable({
		Logger = deps.LoggerService,
		Perm = deps.PermissionService,
		Throttle = deps.ThrottleService,
		GL = deps.GLightsAdapter,
		Pyro = deps.PyroService,      -- PyroService (armed inside)
		Beat = deps.BeatSyncEngine,   -- BeatSyncEngine
		StateUpdate = deps.StateUpdate,

		_stopCinematic = false,
		_stopRhythm = false,

		-- manual target inference for color
		_lastTargetByUserId = {},

		-- pyro runner
		_pyroRunToken = 0,
		_activePyroBeatId = nil,
	}, ShowEngine)

	self.state = {
		status = "Idle",    -- Idle/Running/Blackout/Emergency
		mode = "IDLE",      -- IDLE/CINEMATIC/RHYTHM/MANUAL
		activePresetId = nil,
		activeRhythmId = nil,

		-- baseline 24/7 global
		baseline = {
			enabled = true,
			colorName = "WARM_WHITE",
		},

		-- force night
		forceNight = true,

		-- pyro
		pyroArmed = false,
		activePyroId = nil,

		-- run cancellation
		lockUntil = 0,
		runToken = 0,

		-- rhythm state
		rhythm = {
			enabled = false,
			bpm = 120,
			beatIndex = 0,
			barIndex = 0,
			level = "Low",
			audioPath = "SoundService.ServerMusic",
			thresholds = {100, 250, 450, 650, 850},
			minBeatGap = 0.12,
		},

		lastError = nil,
	}

	return self
end

function ShowEngine:Boot()
	self:_applyNightIfNeeded(true)
	self:_applyBaselineIfNeeded(true)
	self:_broadcast()
end

function ShowEngine:GetState()
	return self.state
end

function ShowEngine:GetSnapshot(player)
	local isOp = self.Perm:IsOperator(player)
	return {
		state = deepCopy(self.state),
		isOperator = isOp,
		logs = self.Logger:GetLast(60),
		cinematicPresets = PresetLibrary.list,
		rhythmPresets = RhythmLibrary.list,
		pyroPresets = PYRO_PRESETS,
		palette = exportPalette(),
	}
end

function ShowEngine:_broadcast()
	self.StateUpdate:FireAllClients({
		state = deepCopy(self.state),
		logs = self.Logger:GetLast(60)
	})
end

function ShowEngine:_locked()
	return now() < (self.state.lockUntil or 0)
end

function ShowEngine:_reject(player, reason)
	self.Logger:Log("REJECT", reason, {userId=player.UserId})
end

function ShowEngine:_applyNightIfNeeded(force)
	if not (self.state.forceNight == true) and not force then return end
	pcall(function()
		Lighting.ClockTime = 0
		Lighting.TimeOfDay = "00:00:00"
	end)
end

function ShowEngine:_applyBaselineIfNeeded(force)
	if not (self.state.baseline and self.state.baseline.enabled) and not force then return end
	local col = Palette[self.state.baseline.colorName] or Palette.WARM_WHITE
	self.GL:EnsureAllOnBaseline(col)
end

function ShowEngine:_bumpTokenAndStopAll()
	self.state.runToken += 1
	self._stopCinematic = true
	self._stopRhythm = true
	self.state.rhythm.enabled = false
end

-- serialize config for DataStore
function ShowEngine:ExportGlobalConfig()
	return {
		baselineEnabled = self.state.baseline.enabled == true,
		baselineColorName = tostring(self.state.baseline.colorName or "WARM_WHITE"),
		forceNight = self.state.forceNight == true,

		lastMode = self.state.mode,
		lastPresetId = self.state.activePresetId,
		lastRhythmId = self.state.activeRhythmId,

		rhythm = {
			audioPath = tostring(self.state.rhythm.audioPath or "SoundService.ServerMusic"),
			thresholds = deepCopy(self.state.rhythm.thresholds),
			minBeatGap = tonumber(self.state.rhythm.minBeatGap) or 0.12,
		},

		pyroArmed = self.state.pyroArmed == true,
	}
end

function ShowEngine:ApplyGlobalConfig(cfg, sourceTag)
	if type(cfg) ~= "table" then return end

	if cfg.baselineEnabled ~= nil then
		self.state.baseline.enabled = cfg.baselineEnabled == true
	end
	if cfg.baselineColorName ~= nil then
		self.state.baseline.colorName = tostring(cfg.baselineColorName)
	end
	if cfg.forceNight ~= nil then
		self.state.forceNight = cfg.forceNight == true
	end

	if cfg.rhythm and type(cfg.rhythm) == "table" then
		if cfg.rhythm.audioPath then self.state.rhythm.audioPath = tostring(cfg.rhythm.audioPath) end
		if type(cfg.rhythm.thresholds) == "table" and #cfg.rhythm.thresholds == 5 then
			self.state.rhythm.thresholds = {
				tonumber(cfg.rhythm.thresholds[1]) or 100,
				tonumber(cfg.rhythm.thresholds[2]) or 250,
				tonumber(cfg.rhythm.thresholds[3]) or 450,
				tonumber(cfg.rhythm.thresholds[4]) or 650,
				tonumber(cfg.rhythm.thresholds[5]) or 850,
			}
		end
		if cfg.rhythm.minBeatGap then
			self.state.rhythm.minBeatGap = math.clamp(tonumber(cfg.rhythm.minBeatGap) or 0.12, 0.06, 0.35)
		end
	end

	-- SAFETY: pyroArmed selalu false saat apply dari global
	self.state.pyroArmed = false
	self.Pyro:SetArmed(false)

	self:_applyNightIfNeeded(true)
	self:_applyBaselineIfNeeded(true)

	self.Logger:Log("GLOBAL","Applied config", {src=sourceTag or "unknown"})
	self:_broadcast()
end

-- ===== Commands =====
function ShowEngine:OnShowCommand(player, payload)
	if type(payload) ~= "table" then return end
	if self:_locked() then self:_reject(player, "LockedDuringEmergency"); return end

	local cmd = payload.cmd
	if type(cmd) ~= "string" then return end

	if not self.Perm:IsOperator(player) then
		self:_reject(player, "NotOperator:"..cmd)
		return
	end

	if not self.Throttle:Allow(player, "ShowCommand", 18) then
		return
	end

	-- Global / Safety
	if cmd == "EMERGENCY" then self:Emergency(player); return end
	if cmd == "BLACKOUT" then self:Blackout(player); return end
	if cmd == "STOP_ALL" then self:StopAll(player); return end

	-- Baseline 24/7
	if cmd == "BASELINE_SET" then
		local enabled = payload.enabled == true
		local colorName = payload.colorName
		self.state.baseline.enabled = enabled
		if type(colorName) == "string" and Palette[colorName] then
			self.state.baseline.colorName = colorName
		end
		self.state.mode = "IDLE"
		self.state.status = "Idle"
		self:_bumpTokenAndStopAll()

		self.GL:CleanupPreset()
		self:_applyNightIfNeeded(true)
		if enabled then self:_applyBaselineIfNeeded(true) end

		self.Logger:Log("BASELINE","Set",{enabled=enabled, color=self.state.baseline.colorName})
		self:_broadcast()
		return
	end

	if cmd == "FORCE_NIGHT" then
		self.state.forceNight = payload.value == true
		self:_applyNightIfNeeded(true)
		self.Logger:Log("LIGHTING","forceNight",{value=self.state.forceNight})
		self:_broadcast()
		return
	end

	-- Pyro arm
	if cmd == "ARM_PYRO" then
		local v = payload.value == true
		self.state.pyroArmed = v
		self.Pyro:SetArmed(v)
		self.Logger:Log("PYRO","ArmedSet",{value=v, by=player.UserId})
		self:_broadcast()
		return
	end

	-- Beat / Rhythm settings
	if cmd == "SET_AUDIO_PATH" then
		local s = tostring(payload.path or "")
		if #s > 0 then
			self.state.rhythm.audioPath = s
			self.Logger:Log("BEAT","AudioPath", {path=s})
			self:_broadcast()
		end
		return
	end

	if cmd == "SET_THRESHOLDS" then
		local th = payload.thresholds
		if type(th) == "table" and #th == 5 then
			self.state.rhythm.thresholds = {
				tonumber(th[1]) or 100,
				tonumber(th[2]) or 250,
				tonumber(th[3]) or 450,
				tonumber(th[4]) or 650,
				tonumber(th[5]) or 850,
			}
			self.Logger:Log("BEAT","Thresholds",{})
			self:_broadcast()
		end
		return
	end

	if cmd == "SET_MIN_BEAT_GAP" then
		local g = tonumber(payload.value)
		if g then
			self.state.rhythm.minBeatGap = math.clamp(g, 0.06, 0.35)
			self.Beat:SetMinBeatGap(player, self.state.rhythm.minBeatGap)
			self:_broadcast()
		end
		return
	end

	if cmd == "TAP_TEMPO" then
		self.Beat:TapTempo(player)
		self.state.rhythm.bpm = self.Beat:GetState().bpm
		self:_broadcast()
		return
	end

	-- Play cinematic / rhythm
	if cmd == "PLAY_CINEMATIC" then
		if type(payload.presetId) == "string" then self:PlayCinematic(payload.presetId) end
		return
	end
	if cmd == "PLAY_RHYTHM" then
		if type(payload.rhythmId) == "string" then self:PlayRhythm(payload.rhythmId) end
		return
	end

	-- Manual (fix: stop preset/rhythm, manual stays)
	if cmd == "MANUAL" then
		self:EnterManual(player, payload)
		return
	end

	-- Pyro presets
	if cmd == "PYRO_RUN" then
		if type(payload.id) == "string" then self:RunPyroPreset(player, payload.id) end
		return
	end

	if cmd == "PYRO_STOP" then
		self:StopPyro(player)
		return
	end
end

function ShowEngine:StopAll(player)
	self.Logger:Log("SHOW","StopAll",{by=player and player.UserId})

	self:_bumpTokenAndStopAll()
	self.state.mode = "IDLE"
	self.state.status = "Idle"
	self.state.activePresetId = nil
	self.state.activeRhythmId = nil
	self.state.activePyroId = nil
	self._activePyroBeatId = nil

	self.Pyro:AllOff()
	self.GL:CleanupPreset()
	-- manual cues boleh tetap? STOP_ALL biasanya harus bersih total
	self.GL:CleanupManual()
	self:_applyBaselineIfNeeded(true)

	self:_broadcast()
end

function ShowEngine:Emergency(player)
	self.state.runToken += 1
	self.state.status = "Emergency"
	self.state.lockUntil = now() + 2.0
	self.state.lastError = nil

	self.Logger:Log("EMERGENCY","Triggered",{by=player and player.UserId})
	self.Pyro:AllOff()
	self.GL:HardResetAll()

	self._stopCinematic = true
	self._stopRhythm = true

	self.state.mode = "IDLE"
	self.state.activePresetId = nil
	self.state.activeRhythmId = nil
	self.state.rhythm.enabled = false
	self.state.activePyroId = nil
	self._activePyroBeatId = nil

	self:_broadcast()

	task.delay(2.0, function()
		if self.state.status == "Emergency" then
			self.state.status = "Idle"
			self:_applyBaselineIfNeeded(true)
			self:_broadcast()
		end
	end)
end

function ShowEngine:Blackout(player)
	self.Logger:Log("SHOW","Blackout",{by=player and player.UserId})

	self:_bumpTokenAndStopAll()
	self.state.status = "Blackout"
	self.state.mode = "IDLE"
	self.state.activePresetId = nil
	self.state.activeRhythmId = nil
	self.state.activePyroId = nil
	self._activePyroBeatId = nil

	self.Pyro:AllOff()
	self.GL:CleanupAll()
	self.GL:Run("ALL","FadeOff",{},nil,nil,"preset")

	self:_broadcast()
end

-- ===== MANUAL MODE =====
function ShowEngine:EnterManual(player, payload)
	local folder = tostring(payload.folder or "ALL")
	local fn = tostring(payload.fn or "")
	local args = payload.args
	if #folder > 48 or #fn > 48 or fn == "" then return end
	if args ~= nil and type(args) ~= "table" then return end

	-- cancel running show
	self:_bumpTokenAndStopAll()
	self.state.status = "Running"
	self.state.mode = "MANUAL"
	self.state.activePresetId = nil
	self.state.activeRhythmId = nil
	self.state.rhythm.enabled = false

	-- stop preset cues only, keep manual
	self.GL:CleanupPreset()

	-- remember last target (for color inference)
	if folder ~= "ALL" then
		self._lastTargetByUserId[player.UserId] = folder
	end

	-- server-side inference: jika UI kirim Color ke ALL, map ke last target
	if fn == "Color" and folder == "ALL" then
		local last = self._lastTargetByUserId[player.UserId]
		if last and last ~= "ALL" then
			folder = last
		end
	end

	self.Logger:Log("MANUAL","Run",{folder=folder, fn=fn})

	-- execute as manual owner
	self.GL:Run(folder, fn, args or {}, payload.selector, nil, "manual")

	-- baseline tetap ON kalau enabled (tapi manual boleh menimpa sementara)
	self:_applyNightIfNeeded(false)

	self:_broadcast()
end

-- ===== Cinematic execution (runToken cancel) =====
function ShowEngine:_waitSeconds(seconds, token)
	local start = now()
	while (now() - start) < seconds do
		if self.state.runToken ~= token then return false end
		task.wait(0.02)
		if self._stopCinematic and self.state.mode=="CINEMATIC" then
			return false
		end
	end
	return true
end

function ShowEngine:_execStep(step, token)
	if self.state.runToken ~= token then return false end
	if self.state.status == "Emergency" then return false end
	if type(step) ~= "table" then return true end

	if step.type == "wait" then
		return self:_waitSeconds(step.seconds or 0, token)
	end

	if step.type == "sys" then
		if step.fn == "CleanupPreset" then
			self.GL:CleanupPreset()
		elseif step.fn == "EnsureAllOnBaseline" then
			self.GL:EnsureAllOnBaseline(step.args and step.args[1])
		end
		return true
	end

	if step.type == "gl" then
		self.GL:Run(step.folder, step.fn, step.args, step.selector, nil, "preset")
		return true
	end

	if step.type == "pyro" then
		local requireArmed = step.requireArmed == true
		self.Pyro:Fire(step.device, step.pattern, step.args, requireArmed, function()
			return (self.state.runToken == token) and (self.state.status ~= "Emergency")
		end)
		return true
	end

	return true
end

function ShowEngine:PlayCinematic(presetId)
	local preset = PresetLibrary.byId[presetId]
	if not preset then return end

	self._stopCinematic = false
	self._stopRhythm = true
	self.state.runToken += 1
	local token = self.state.runToken

	self.state.status = "Running"
	self.state.mode = "CINEMATIC"
	self.state.activePresetId = presetId
	self.state.activeRhythmId = nil
	self.state.rhythm.enabled = false
	self.state.lastError = nil

	-- ensure baseline on start (but presets can override)
	self:_applyNightIfNeeded(false)
	self:_applyBaselineIfNeeded(false)

	self:_broadcast()

	task.spawn(function()
		local ok, err = pcall(function()
			for _,step in ipairs((preset.phases and preset.phases.setup) or {}) do
				if self.state.runToken ~= token then return end
				self:_execStep(step, token)
			end

			for _,step in ipairs((preset.phases and preset.phases.intro) or {}) do
				if self.state.runToken ~= token then return end
				self:_execStep(step, token)
			end

			local segOrder = {"A","B","C"}
			local idx = 1

			while self.state.runToken == token and (not self._stopCinematic) do
				local seg = segOrder[idx]
				local loop = preset.phases and preset.phases.loop and preset.phases.loop[seg]
				for _,step in ipairs(loop or {}) do
					if self.state.runToken ~= token then return end
					local cont = self:_execStep(step, token)
					if cont == false then break end
				end

				idx += 1
				if idx > #segOrder then idx = 1 end
				task.wait() -- a loop with no wait step must not spin without yielding
			end

			for _,step in ipairs((preset.phases and preset.phases.outro) or {}) do
				if self.state.runToken ~= token then return end
				self:_execStep(step, token)
			end

			if self.state.runToken == token then
				self.state.status = "Idle"
				self.state.activePresetId = nil
				self.state.mode = "IDLE"
				self.GL:CleanupPreset()
				self:_applyBaselineIfNeeded(true)
				self:_broadcast()
			end
		end)

		if not ok then
			self.state.lastError = tostring(err)
			self.Logger:Log("ERROR","Cinematic error",{err=tostring(err)})
			self.state.status = "Blackout"
			self.GL:CleanupPreset()
			self.GL:Run("ALL","FadeOff",{},nil,nil,"preset")
			self:_broadcast()
		end
	end)
end

-- ===== Rhythm execution (beat-driven) =====
function ShowEngine:PlayRhythm(rhythmId)
	local rp = RhythmLibrary.byId[rhythmId]
	if not rp then return end

	self._stopCinematic = true
	self.state.runToken += 1
	local token = self.state.runToken

	self.state.status = "Running"
	self.state.mode = "RHYTHM"
	self.state.activeRhythmId = rhythmId
	self.state.activePresetId = nil
	self.state.rhythm.enabled = true
	self._stopRhythm = false
	self.state.lastError = nil

	self.state.rhythm.beatIndex = 0
	self.state.rhythm.barIndex = 0
	self.state.rhythm.level = "Low"

	self:_applyNightIfNeeded(false)
	self:_applyBaselineIfNeeded(false)

	self:_broadcast()

	task.spawn(function()
		local ok, err = pcall(function()
			for _,cmd in ipairs(rp.onEnter or {}) do
				if self.state.runToken ~= token then return end
				self:_execRhythmCmd(cmd, token, rp)
			end

			-- idle loop just to keep override/night/baseline
			while self.state.runToken == token and (not self._stopRhythm) and self.state.mode=="RHYTHM" do
				task.wait(0.25)
				self:_applyNightIfNeeded(false)
			end

			for _,cmd in ipairs(rp.onExit or {}) do
				if self.state.runToken ~= token then return end
				self:_execRhythmCmd(cmd, token, rp)
			end

			if self.state.runToken == token then
				self.state.status = "Idle"
				self.state.activeRhythmId = nil
				self.state.rhythm.enabled = false
				self.state.mode = "IDLE"
				self.GL:CleanupPreset()
				self:_applyBaselineIfNeeded(true)
				self:_broadcast()
			end
		end)

		if not ok then
			self.state.lastError = tostring(err)
			self.Logger:Log("ERROR","Rhythm error",{err=tostring(err)})
			self.state.status = "Blackout"
			self.GL:CleanupPreset()
			self.GL:Run("ALL","FadeOff",{},nil,nil,"preset")
			self:_broadcast()
		end
	end)
end

local function levelRank(name)
	local map = {Low=1, Med=2, Medium=2, High=3, Insane=4, Nuclear=5}
	return map[tostring(name)] or 1
end

function ShowEngine:_execRhythmCmd(cmd, token, rp)
	if self.state.runToken ~= token then return end
	if type(cmd) ~= "table" then return end

	if cmd.type == "sys" then
		if cmd.fn=="CleanupPreset" then self.GL:CleanupPreset() end
		if cmd.fn=="EnsureAllOnBaseline" then
			local c = cmd.args and cmd.args[1]
			self.GL:EnsureAllOnBaseline(c)
		end
		return
	end

	if cmd.type == "gl" then
		self.GL:Run(cmd.folder, cmd.fn, cmd.args, cmd.selector, nil, "preset")
		return
	end

	if cmd.type == "set" then
		self.state.rhythmState = self.state.rhythmState or {}
		self.state.rhythmState[cmd.key] = cmd.value
		return
	end

	if cmd.type == "toggle" then
		self.state.rhythmState = self.state.rhythmState or {}
		local v = self.state.rhythmState[cmd.key] == true
		self.state.rhythmState[cmd.key] = (not v)
		return
	end

	if cmd.type == "inc" then
		self.state.rhythmState = self.state.rhythmState or {}
		local v = tonumber(self.state.rhythmState[cmd.key] or 0) or 0
		self.state.rhythmState[cmd.key] = v + (cmd.delta or 1)
		return
	end

	if cmd.type == "branch" then
		self.state.rhythmState = self.state.rhythmState or {}
		local v = self.state.rhythmState[cmd.key] == true
		local list = v and cmd.ifTrue or cmd.ifFalse
		for _,c in ipairs(list or {}) do self:_execRhythmCmd(c, token, rp) end
		return
	end

	if cmd.type == "altByParity" then
		self.state.rhythmState = self.state.rhythmState or {}
		local v = tonumber(self.state.rhythmState[cmd.key] or 0) or 0
		local list = ((v % 2)==0) and cmd.even or cmd.odd
		for _,c in ipairs(list or {}) do self:_execRhythmCmd(c, token, rp) end
		return
	end

	if cmd.type == "levelColor" then
		local map = cmd.map or {}
		local lvl = tostring(self.state.rhythm.level or "Low")
		local col = map[lvl] or map.Med or Palette.WARM_WHITE
		self.GL:Run(cmd.folder or "ALL", "Color", {col}, cmd.selector, nil, "preset")
		return
	end

	if cmd.type == "pyro" then
		local pol = rp.pyroPolicy or {}
		if cmd.device=="FPA" and pol.allowFPA==false then return end
		if cmd.device=="CONFETTI" and pol.allowConfetti==false then return end
		if cmd.device=="SMOKE" and pol.allowSmoke==false then return end

		local g = cmd.gate or {}
		if g.levelAtLeast and levelRank(self.state.rhythm.level) < levelRank(g.levelAtLeast) then return end
		if g.everyNBeats and ((self.state.rhythm.beatIndex % g.everyNBeats) ~= 0) then return end
		if g.everyNBars and ((self.state.rhythm.barIndex % g.everyNBars) ~= 0) then return end

		self.Pyro:Fire(cmd.device, cmd.pattern, cmd.args, true, function()
			return (self.state.runToken == token) and (self.state.status ~= "Emergency")
		end)
		return
	end
end

-- Called by BeatSyncEngine
function ShowEngine:OnBeat(beatPayload)
	if type(beatPayload) ~= "table" then return end
	-- always update night if forced
	self:_applyNightIfNeeded(false)

	-- run beat-synced pyro preset even outside RHYTHM
	self:_pyroBeatDispatch(beatPayload)

	if self.state.mode ~= "RHYTHM" then return end
	if not self.state.rhythm.enabled then return end
	if self.state.status == "Emergency" then return end
	if self._stopRhythm then return end

	local rp = RhythmLibrary.byId[self.state.activeRhythmId]
	if not rp then return end

	self.state.rhythm.beatIndex = beatPayload.beatIndex or (self.state.rhythm.beatIndex + 1)
	self.state.rhythm.barIndex = beatPayload.barIndex or self.state.rhythm.barIndex
	self.state.rhythm.level = beatPayload.level or self.state.rhythm.level
	self.state.rhythm.bpm = beatPayload.bpm or self.state.rhythm.bpm

	local token = self.state.runToken

	for _,cmd in ipairs(rp.onBeat or {}) do
		self:_execRhythmCmd(cmd, token, rp)
	end

	-- onBar tiap beatsInBar
	local bib = tonumber(self.Beat:GetState().beatsInBar) or 4
	if (self.state.rhythm.beatIndex % bib) == 0 then
		for _,cmd in ipairs(rp.onBar or {}) do
			self:_execRhythmCmd(cmd, token, rp)
		end
	end

	self:_broadcast()
end

-- ===== Pyro presets runner =====
function ShowEngine:StopPyro(player)
	self._pyroRunToken += 1
	self.state.activePyroId = nil
	self._activePyroBeatId = nil
	self.Pyro:AllOff()
	self.Logger:Log("PYRO","StopPreset",{by=player and player.UserId})
	self:_broadcast()
end

function ShowEngine:RunPyroPreset(player, presetId)
	local p = PYRO_BY_ID[presetId]
	if not p then return end

	-- must be armed
	if not self.state.pyroArmed then
		self.Logger:Log("PYRO_FAIL","Run blocked (not armed)",{id=presetId})
		self:_broadcast()
		return
	end

	self.state.activePyroId = presetId
	self.Logger:Log("PYRO","RunPreset",{id=presetId, mode=p.mode})

	if p.mode == "sequence" then
		self._pyroRunToken += 1
		local myTok = self._pyroRunToken

		task.spawn(function()
			for _,s in ipairs(p.steps or {}) do
				if myTok ~= self._pyroRunToken then return end
				if s.wait then
					task.wait(tonumber(s.wait) or 0.1)
				else
					self.Pyro:Fire(s.device, s.pattern, s.args, true, function()
						return (myTok == self._pyroRunToken) and (self.state.status ~= "Emergency")
					end)
				end
			end
			if myTok == self._pyroRunToken then
				-- sequence selesai tapi status preset tetap ditandai (biar UI tahu terakhir)
				self:_broadcast()
			end
		end)
	else
		-- beat synced
		self._activePyroBeatId = presetId
		self:_broadcast()
	end
end

function ShowEngine:_pyroBeatDispatch(beatPayload)
	local id = self._activePyroBeatId
	if not id then return end
	local beatIndex = tonumber(beatPayload.beatIndex) or 0

	local p = PYRO_BY_ID[id]
	if not p then return end
	if not self.state.pyroArmed then return end

	-- everyNBeats
	if p.onBeat and p.onBeat.everyNBeats then
		local n = tonumber(p.onBeat.everyNBeats) or 1
		if (beatIndex % n) == 0 then
			self.Pyro:Fire(p.onBeat.device, p.onBeat.pattern, p.onBeat.args, true, function()
				return (self.state.status ~= "Emergency") and (self._activePyroBeatId == id)
			end)
		end
	end

	-- everyNBars
	local bib = tonumber(self.Beat:GetState().beatsInBar) or 4
	if p.onBar and (beatIndex % bib) == 0 then
		local barIdx = beatPayload.barIndex or 0
		local n = tonumber(p.onBar.everyNBars) or 1
		if (barIdx % n) == 0 then
			self.Pyro:Fire(p.onBar.device, p.onBar.pattern, p.onBar.args, true, function()
				return (self.state.status ~= "Emergency") and (self._activePyroBeatId == id)
			end)
		end
	end
end

return ShowEngine
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">ThrottleService</string>
          <string name="Source"><![CDATA[local ThrottleService = {}
ThrottleService.__index = ThrottleService

function ThrottleService.new(Logger)
	local self = setmetatable({
		Logger = Logger,
		perPlayer = {},
	}, ThrottleService)
	game:GetService("Players").PlayerRemoving:Connect(function(player)
		self:Forget(player)
	end)
	return self
end

local function now()
	return os.clock()
end

function ThrottleService:_slot(userId, key)
	self.perPlayer[userId] = self.perPlayer[userId] or {}
	self.perPlayer[userId][key] = self.perPlayer[userId][key] or {
		windowStart = now(),
		count = 0
	}
	return self.perPlayer[userId][key]
end

function ThrottleService:Allow(player, key, limitPerSec)
	limitPerSec = limitPerSec or 8

	local s = self:_slot(player.UserId, key)
	local t = now()

	-- Reset window every second
	if (t - s.windowStart) >= 1.0 then
		s.windowStart = t
		s.count = 0
	end

	s.count = s.count + 1

	-- Check limit
	if s.count > limitPerSec then
		self.Logger:Log("THROTTLE", "Rejected spam", {
			userId = player.UserId,
			key = key,
			count = s.count
		})
		return false
	end

	return true
end

-- Patch notes (PAUL): drop a player's counters when they leave (they used to pile up).
function ThrottleService:Forget(player)
	self.perPlayer[player.UserId] = nil
end

return ThrottleService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">AutoLightsAccess</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/AutoLightsAccess.lua
-- Who may operate the show (AutoLights Control Panel, ShowEngine commands).
-- Rules, checked once per player and then cached:
--   • Roblox Studio: everyone (so you can test alone)
--   • CONTROL.PublicAccess = true: everyone
--   • the game owner (user, or the owner of the group that owns the game)
--   • CONTROL.UserIds, and members of CONTROL.GroupId with rank >= CONTROL.MinRank
-- Everything else is refused on the server; the panel only hides itself.

local GroupService = game:GetService("GroupService")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Access = {}

local cache = {} -- [Player] = boolean

local function controlSettings()
	local config = script.Parent.Parent:FindFirstChild("AutoLightsSyncConfig")
	local ok, settings = pcall(function()
		return config and require(config).CONTROL
	end)
	return if ok and type(settings) == "table" then settings else {}
end

local function isOwner(player)
	if game.CreatorType == Enum.CreatorType.Group then
		local ok, info = pcall(GroupService.GetGroupInfoAsync, GroupService, game.CreatorId)
		return ok and type(info) == "table" and info.Owner ~= nil and info.Owner.Id == player.UserId
	end
	return game.CreatorId ~= 0 and player.UserId == game.CreatorId
end

local function compute(player)
	if RunService:IsStudio() then
		return true
	end
	local settings = controlSettings()
	if settings.PublicAccess == true then
		return true
	end
	if isOwner(player) then
		return true
	end
	if type(settings.UserIds) == "table" and table.find(settings.UserIds, player.UserId) then
		return true
	end
	local groupId = tonumber(settings.GroupId) or 0
	if groupId ~= 0 then
		local ok, rank = pcall(player.GetRankInGroup, player, groupId)
		if ok and rank >= (tonumber(settings.MinRank) or 1) then
			return true
		end
	end
	return false
end

-- May yield (group lookups).
function Access.IsOperator(player)
	if typeof(player) ~= "Instance" or not player:IsA("Player") then
		return false
	end
	if cache[player] == nil then
		cache[player] = compute(player)
	end
	return cache[player]
end

function Access.Forget(player)
	cache[player] = nil
end

Players.PlayerRemoving:Connect(Access.Forget)

return Access
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">AutoLightsState</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/AutoLightsState.lua
-- The on/off switches of the AutoLights Control Panel. They live as attributes on
-- ReplicatedStorage.AutoLights, so every script (and every client) reads the same value:
--   SyncEnabled       beat sync drives the lights            (default true)
--   DanceFloorEnabled the dance floor tiles are active       (default true)
--   PyroEnabled       pyro / smoke / confetti may fire       (default true)
-- A switch that was never set counts as ON.

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local State = {}

function State.Root()
	return ReplicatedStorage:FindFirstChild("AutoLights")
end

function State.Get(key, default)
	local root = State.Root()
	local value = root and root:GetAttribute(key)
	if value == nil then
		return default
	end
	return value
end

function State.Set(key, value)
	local root = State.Root()
	if root then
		root:SetAttribute(key, value)
	end
end

function State.SyncEnabled()
	return State.Get("SyncEnabled", true) ~= false
end

function State.DanceFloorEnabled()
	return State.Get("DanceFloorEnabled", true) ~= false
end

function State.PyroEnabled()
	return State.Get("PyroEnabled", true) ~= false
end

return State
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="Script" referent="19">
      <Properties>
        <string name="Name">AutoLightsControl</string>
        <string name="Source"><![CDATA[-- AutoLightsControl.server.lua  —  AutoLights Control Panel (server side)
-- Place in: ServerScriptService > AutoLightsServer
-- by PAUL
--
-- Runs the switches and buttons of the AutoLightsPanel GUI:
--   Sync ON/OFF, Dance Floor ON/OFF, Auto pattern, Pattern / Brightness / Test flash,
--   Pyro ON/OFF + CO2 / Confetti / Smoke bursts + Stop pyro, Blackout / Restore.
--
-- How it works
--   • The switches are attributes on ReplicatedStorage.AutoLights (see AutoLightsState and the
--     header of DanceFloorSync). Only this script writes them, so a player cannot flip a
--     switch on his own; the panel just calls the Control remote.
--   • Every call is checked on the server: the player must be an operator (AutoLightsAccess:
--     owner, CONTROL.UserIds, CONTROL.GroupId, or anybody in Roblox Studio) and is rate limited.
--   • The Sync and Dance Floor switches work by themselves (DanceFloorSync obeys them).
--     Pyro and the GLights Blackout/Restore reach the G-Lights modules through a "bridge":
--     the vendor classes are wrapped so the Pyro switch and the Sync switch also apply to
--     them, and Blackout/Restore use their GLightsAdapter. If those modules are not
--     available the bridge stays off (HasLights / HasPyro = false) and the panel greys the
--     buttons out; nothing else is affected.

local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local AutoLightsServer = script.Parent
local Modules          = AutoLightsServer:WaitForChild("Modules")
local Access           = require(Modules:WaitForChild("AutoLightsAccess"))
local State            = require(Modules:WaitForChild("AutoLightsState"))
local LoggerService    = require(Modules:WaitForChild("LoggerService"))
local Logger           = LoggerService.new()

local okConfig, SyncCFG = pcall(function()
	return require(AutoLightsServer:WaitForChild("AutoLightsSyncConfig", 5))
end)
local CONTROL = (okConfig and type(SyncCFG) == "table" and SyncCFG.CONTROL) or {}

-- ─────────────────────────────────────────────────────────────────
-- Folders and remotes
-- ─────────────────────────────────────────────────────────────────
local function getOrCreate(parent, className, name)
	local instance = parent:FindFirstChild(name)
	if not instance then
		instance = Instance.new(className)
		instance.Name = name
		instance.Parent = parent
	end
	return instance
end

local autoRoot      = getOrCreate(ReplicatedStorage, "Folder", "AutoLights")
local remotes       = getOrCreate(autoRoot, "Folder", "Remotes")
local controlRemote = getOrCreate(remotes, "RemoteFunction", "Control")

local function initAttribute(name, value)
	if autoRoot:GetAttribute(name) == nil then
		autoRoot:SetAttribute(name, value)
	end
end

initAttribute("SyncEnabled", CONTROL.SyncOnAtStart ~= false)
initAttribute("DanceFloorEnabled", CONTROL.DanceFloorOnAtStart ~= false)
initAttribute("PyroEnabled", CONTROL.PyroOnAtStart ~= false)
initAttribute("DFAutoPattern", true)
initAttribute("DFBrightness", 1)
initAttribute("Blackout", false)
initAttribute("HasLights", false)
initAttribute("HasPyro", false)
autoRoot:SetAttribute("Watermark", tostring(CONTROL.Watermark or "PAUL"))
autoRoot:SetAttribute("ControlReady", true)

-- ─────────────────────────────────────────────────────────────────
-- Bridge to the G-Lights modules (best effort, never fatal)
-- ─────────────────────────────────────────────────────────────────
local bridge = { GLClass = nil, PyroClass = nil, gl = nil, pyro = nil }

local function capture(kind, self)
	if bridge[kind] == nil and type(self) == "table" then
		bridge[kind] = self
	end
end

-- Replaces class[name] by a wrapper; `wrapper(original, self, ...)` decides what happens.
local function patch(class, name, wrapper)
	local original = class[name]
	if type(original) ~= "function" then
		return false
	end
	class[name] = function(self, ...)
		return wrapper(original, self, ...)
	end
	return true
end

local function installBridge()
	-- The vendor modules refuse to load until the license folder exists.
	if not ReplicatedStorage:WaitForChild("GLightsPhantomLicense", 30) then
		warn("[AutoLightsControl] license folder not found; Pyro / GLights buttons are off")
		return
	end

	local okBeat, BeatService = pcall(function() return require(Modules:WaitForChild("BeatService")) end)
	if okBeat and type(BeatService) == "table" then
		-- the Sync switch also silences every BeatService in the game (AutoSync included)
		patch(BeatService, "StepFromRms", function(original, self, ...)
			if not State.SyncEnabled() then return nil end
			return original(self, ...)
		end)
		patch(BeatService, "ForceBeat", function(original, self, ...)
			if not State.SyncEnabled() then return nil end
			return original(self, ...)
		end)
	end

	local okGL, GLightsAdapter = pcall(function() return require(Modules:WaitForChild("GLightsAdapter")) end)
	if okGL and type(GLightsAdapter) == "table" then
		bridge.GLClass = GLightsAdapter
		for _, name in { "Run", "CleanupPreset", "EnsureAllOnBaseline", "HardResetAll" } do
			patch(GLightsAdapter, name, function(original, self, ...)
				capture("gl", self)
				return original(self, ...)
			end)
		end
		autoRoot:SetAttribute("HasLights", true)
	end

	local okPyro, PyroService = pcall(function() return require(Modules:WaitForChild("PyroService")) end)
	if okPyro and type(PyroService) == "table" then
		bridge.PyroClass = PyroService
		patch(PyroService, "Fire", function(original, self, ...)
			capture("pyro", self)
			if not State.PyroEnabled() then
				return false, "pyro switch is off"
			end
			return original(self, ...)
		end)
		autoRoot:SetAttribute("HasPyro", true)
	end
end

task.spawn(function()
	local ok, err = pcall(installBridge)
	if not ok then
		warn("[AutoLightsControl] bridge failed: " .. tostring(err))
	end
end)

local function getGL()
	if bridge.gl then return bridge.gl end
	if bridge.GLClass then
		local ok, obj = pcall(function() return bridge.GLClass.new(Logger) end)
		if ok and obj then bridge.gl = obj end
	end
	return bridge.gl
end

local function getPyro()
	if bridge.pyro then return bridge.pyro end
	if bridge.PyroClass then
		local ok, obj = pcall(function() return bridge.PyroClass.new(Logger, getGL()) end)
		if not ok or not obj then
			ok, obj = pcall(function() return bridge.PyroClass.new(Logger) end)
		end
		if ok and obj then bridge.pyro = obj end
	end
	return bridge.pyro
end

local function warmWhite()
	local ok, color = pcall(function()
		local shared = autoRoot:FindFirstChild("Shared")
		local palette = shared and shared:FindFirstChild("Palette") and require(shared.Palette)
		return palette and palette.WARM_WHITE
	end)
	return if ok and typeof(color) == "Color3" then color else Color3.fromRGB(255, 214, 170)
end

-- ─────────────────────────────────────────────────────────────────
-- State snapshot
-- ─────────────────────────────────────────────────────────────────
local function patternCount()
	return math.max(1, math.floor(tonumber(autoRoot:GetAttribute("DFPatternCount")) or 12))
end

local function snapshot()
	return {
		sync         = State.SyncEnabled(),
		danceFloor   = State.DanceFloorEnabled(),
		pyro         = State.PyroEnabled(),
		blackout     = autoRoot:GetAttribute("Blackout") == true,
		autoPattern  = autoRoot:GetAttribute("DFAutoPattern") ~= false,
		brightness   = tonumber(autoRoot:GetAttribute("DFBrightness")) or 1,
		pattern      = tonumber(autoRoot:GetAttribute("DFPatternNow")) or 1,
		patternName  = tostring(autoRoot:GetAttribute("DFPatternName") or ""),
		patternCount = patternCount(),
		hasLights    = autoRoot:GetAttribute("HasLights") == true,
		hasPyro      = autoRoot:GetAttribute("HasPyro") == true,
	}
end

-- ─────────────────────────────────────────────────────────────────
-- Actions
-- ─────────────────────────────────────────────────────────────────
local function fail(message)
	return { ok = false, message = message, state = snapshot() }
end

local function done(message)
	return { ok = true, message = message, state = snapshot() }
end

local PYRO_BURSTS = {
	CO2      = { "FPA", "AllHold", { duration = 0.25 } },
	CONFETTI = { "CONFETTI", "Burst", { duration = 1.2 } },
	SMOKE    = { "SMOKE", "Burst", { duration = 1.0 } },
}

local function pyroAllOff()
	local pyro = bridge.pyro or (bridge.PyroClass and getPyro())
	if pyro then
		pcall(function() pyro:AllOff() end)
	end
end

local function setPyro(on)
	State.Set("PyroEnabled", on)
	local pyro = getPyro()
	if pyro then
		pcall(function() pyro:SetArmed(on) end)
		if not on then pyroAllOff() end
	end
end

local ACTIONS = {}

function ACTIONS.Sync(value)
	State.Set("SyncEnabled", value == true)
	return done(if value == true then "Sync ON" else "Sync OFF")
end

function ACTIONS.DanceFloor(value)
	State.Set("DanceFloorEnabled", value == true)
	return done(if value == true then "Dance floor ON" else "Dance floor OFF")
end

function ACTIONS.Pyro(value)
	setPyro(value == true)
	return done(if value == true then "Pyro ON" else "Pyro OFF")
end

function ACTIONS.AutoPattern(value)
	autoRoot:SetAttribute("DFAutoPattern", value == true)
	return done(if value == true then "Auto pattern ON" else "Pattern locked")
end

function ACTIONS.Brightness(value)
	local number = tonumber(value)
	if not number or number ~= number then return fail("Invalid brightness") end
	autoRoot:SetAttribute("DFBrightness", math.clamp(number, 0.1, 1))
	return done("Brightness set")
end

local function stepPattern(delta)
	local count = patternCount()
	local current = math.floor(tonumber(autoRoot:GetAttribute("DFPatternNow")) or 1)
	autoRoot:SetAttribute("DFPattern", ((current - 1 + delta) % count) + 1)
	autoRoot:SetAttribute("DFAutoPattern", false) -- picking a pattern pins it
	return done("Pattern locked")
end

function ACTIONS.NextPattern() return stepPattern(1) end
function ACTIONS.PrevPattern() return stepPattern(-1) end

function ACTIONS.Pattern(value)
	local index = tonumber(value)
	if not index or index ~= index then return fail("Invalid pattern") end
	autoRoot:SetAttribute("DFPattern", math.clamp(math.floor(index), 1, patternCount()))
	autoRoot:SetAttribute("DFAutoPattern", false)
	return done("Pattern locked")
end

function ACTIONS.Pulse()
	if not State.DanceFloorEnabled() then return fail("Dance floor is OFF") end
	autoRoot:SetAttribute("DFPulse", (tonumber(autoRoot:GetAttribute("DFPulse")) or 0) + 1)
	return done("Flash")
end

function ACTIONS.StopPyro()
	pyroAllOff()
	return done("Pyro stopped")
end

function ACTIONS.Fire(kind)
	local burst = type(kind) == "string" and PYRO_BURSTS[kind]
	if not burst then return fail("Unknown effect") end
	if not State.PyroEnabled() then return fail("Pyro is OFF") end
	local pyro = getPyro()
	if not pyro then return fail("Pyro system not found") end
	-- The Pyro switch is the arm switch: PyroService only fires when armed.
	pcall(function() pyro:SetArmed(true) end)
	local ok, fired, why = pcall(function() return pyro:Fire(burst[1], burst[2], table.clone(burst[3]), true, nil) end)
	if not ok then return fail("Pyro error") end
	if fired == false then return fail(tostring(why or "Pyro blocked")) end
	return done(kind .. " fired")
end

function ACTIONS.Blackout()
	autoRoot:SetAttribute("Blackout", true)
	State.Set("SyncEnabled", false)
	State.Set("DanceFloorEnabled", false)
	pyroAllOff()
	local gl = getGL()
	if gl then
		pcall(function() gl:CleanupPreset() end)
		pcall(function() gl:Run("ALL", "FadeOff", {}, nil, nil, "preset") end)
	end
	return done("Blackout")
end

function ACTIONS.Restore()
	autoRoot:SetAttribute("Blackout", false)
	State.Set("SyncEnabled", true)
	State.Set("DanceFloorEnabled", true)
	local gl = getGL()
	if gl then
		pcall(function() gl:EnsureAllOnBaseline(warmWhite()) end)
	end
	return done("Restored")
end

-- ─────────────────────────────────────────────────────────────────
-- Remote
-- ─────────────────────────────────────────────────────────────────
local lastCall = {} -- [Player] = { start, count }

local function allowed(player)
	local now = os.clock()
	local slot = lastCall[player]
	if not slot or now - slot.start >= 1 then
		slot = { start = now, count = 0 }
		lastCall[player] = slot
	end
	slot.count += 1
	return slot.count <= 12
end

controlRemote.OnServerInvoke = function(player, action, value)
	if not Access.IsOperator(player) then
		return { ok = false, message = "Not allowed" }
	end
	if not allowed(player) then
		return fail("Slow down")
	end
	if action == "Get" then
		return { ok = true, state = snapshot() }
	end
	local handler = type(action) == "string" and ACTIONS[action]
	if not handler then
		return fail("Unknown action")
	end
	return handler(value)
end

-- ─────────────────────────────────────────────────────────────────
-- Who sees the panel
-- ─────────────────────────────────────────────────────────────────
local function markOperator(player)
	task.spawn(function()
		local isOperator = Access.IsOperator(player)
		if player.Parent == Players then
			player:SetAttribute("AutoLightsOperator", isOperator)
		end
	end)
end

Players.PlayerAdded:Connect(markOperator)
for _, player in Players:GetPlayers() do
	markOperator(player)
end
Players.PlayerRemoving:Connect(function(player)
	lastCall[player] = nil
end)
]]></string>
      </Properties>
    </Item>
  </Item>
</roblox>