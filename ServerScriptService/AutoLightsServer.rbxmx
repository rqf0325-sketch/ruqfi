      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">LoggerService</string>
          <string name="Source">-- ServerScriptService/AutoLightsServer/Modules/LoggerService.lua
-- ★ SILENT EDITION — all logging suppressed
-- Replace the original LoggerService with this to clean up output.

local LoggerService = {}
LoggerService.__index = LoggerService

function LoggerService.new()
	return setmetatable({ _logs = {} }, LoggerService)
end

-- All log calls are silently discarded
function LoggerService:Log(_kind, _msg, _data) end

-- Returns empty log list (UI/boot data won't break)
function LoggerService:GetLast(_n)
	return {}
end

return LoggerService</string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">PermissionService</string>
          <string name="Source"><![CDATA[local Access = require(script.Parent:WaitForChild("AutoLightsAccess"))

local PermissionService = {}
PermissionService.__index = PermissionService

function PermissionService.new(Logger)
	return setmetatable({
		Logger = Logger,
	}, PermissionService)
end

-- Patch notes (PAUL): this used to return true for every player ("full public
-- access"). It now follows AutoLightsAccess (owner, CONTROL.UserIds, group rank);
-- set CONTROL.PublicAccess = true in AutoLightsSyncConfig to open it up again.
function PermissionService:IsOperator(player)
	return Access.IsOperator(player)
end

return PermissionService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">PresetRunner</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/PresetRunner.lua
--
-- Patch notes (PAUL):
--   • Play used to reset the stop flag right after Stop(), so the previous preset
--     kept running next to the new one. Every Play now gets its own run id and an
--     old run ends as soon as the id changes.
--   • A loop without any wait (or a preset with no loop) spun without yielding and
--     froze the server; the loop now always yields at least once per pass.
local PresetRunner = {}
PresetRunner.__index = PresetRunner

function PresetRunner.new(Logger, GLAdapter)
	return setmetatable({
		Logger = Logger,
		GL = GLAdapter,
		_running = false,
		_currentId = nil,
		_runId = 0,
		_speedMul = 1.0, -- NEW
	}, PresetRunner)
end

local function deepCopy(t)
	if type(t) ~= "table" then return t end
	local o = {}
	for k,v in pairs(t) do
		o[k] = deepCopy(v)
	end
	return o
end

function PresetRunner:SetSpeedMultiplier(m)
	m = tonumber(m) or 1.0
	self._speedMul = math.clamp(m, 0.25, 3.0)
end

function PresetRunner:IsRunning()
	return self._running
end

function PresetRunner:Stop()
	self._runId += 1
	self._running = false
	self._currentId = nil
end

function PresetRunner:_runSteps(steps, runId)
	for _,step in ipairs(steps or {}) do
		if self._runId ~= runId then return false end

		if step.type == "wait" then
			local t0 = os.clock()
			local dur = (step.seconds or 0) * (self._speedMul or 1.0)
			while (os.clock() - t0) < dur do
				if self._runId ~= runId then return false end
				task.wait(0.05)
			end

		elseif step.type == "gl" then
			self.GL:Run(step.folder, step.fn, deepCopy(step.args))

		elseif step.type == "sys" then
			if step.fn == "CleanupPreset" then
				self.GL:CleanupPreset()
			elseif step.fn == "EnsureAllOnBaseline" then
				local color = step.args and step.args[1]
				self.GL:EnsureAllOnBaseline(color)
			elseif step.fn == "HardResetAll" then
				self.GL:HardResetAll()
			end
		end
	end
	return self._runId == runId
end

function PresetRunner:Play(preset)
	self:Stop()
	local runId = self._runId
	self._running = true
	self._currentId = preset.id

	task.spawn(function()
		local ok = pcall(function()
			local phases = preset.phases or {}
			self:_runSteps(phases.setup, runId)
			self:_runSteps(phases.intro, runId)

			while self._runId == runId do
				local loop = phases.loop or {}
				for _,key in ipairs({"A","B","C"}) do
					if self._runId ~= runId then break end
					self:_runSteps(loop[key], runId)
				end
				task.wait() -- never spin without yielding, even if the loop has no wait step
			end

			self:_runSteps(phases.outro, runId)
		end)

		if not ok then
			self.Logger:Log("PRESET_ERR","Preset crashed",{id=preset.id})
		end
		-- only the run that is still current may mark the runner as idle
		if self._runId == runId then
			self._running = false
		end
	end)
end

return PresetRunner
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">PyroAdapter</string>
          <string name="Source"><![CDATA[-- ServerScriptService/AutoLightsServer/Modules/PyroAdapter.lua
local State = require(script.Parent:WaitForChild("AutoLightsState"))

local PyroAdapter = {}
PyroAdapter.__index = PyroAdapter

function PyroAdapter.new(Logger, PyroServiceInstance)
	return setmetatable({
		Logger = Logger,
		PyroService = PyroServiceInstance, -- NEW: wajib diinject dari Main.server
	}, PyroAdapter)
end

local function mapLegacy(device, pattern, args)
	args = args or {}

	if device == "FPA" then
		-- UI legacy
		if pattern == "Burst" then
			return "AllHold", { duration = args.duration or 0.25 }
		end
		if pattern == "Left" then
			return "WaveL2R", { interval = args.interval or 0.08 }
		end
		if pattern == "Right" then
			return "WaveR2L", { interval = args.interval or 0.08 }
		end
	end

	return pattern, args
end

function PyroAdapter:Fire(device, pattern, args)
	if not self.PyroService then
		self.Logger:Log("PYRO", "Pyro skipped (no PyroService)", {device=device, pattern=pattern})
		return
	end

	-- Patch notes (PAUL): the Control Panel's Pyro switch.
	if not State.PyroEnabled() then
		return
	end

	local pat, a = mapLegacy(device, pattern, args)

	local ok, why = self.PyroService:Fire(device, pat, a, true, nil)
	if not ok then
		self.Logger:Log("PYRO_FAIL", "Pyro blocked", {device=device, pattern=pat, why=why})
	end
end

return PyroAdapter
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
