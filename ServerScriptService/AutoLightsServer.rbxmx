68-(-320670)]]w=x[u]P=x[S[-606927-(-606930)]]c=x[S[746686+-746682]]Q=c(i,W)R=P[Q]P={Y}V=M(w,R,P)w=Z(951533+-1013251)i=13052849687648-(-674654)Y=nil Q=Z(651176+-713865)V=T[w]R=x[S[344099-344096]]P=x[S[609887-609883]]c=P(Q,i)w=R[c]R=a(-884241+17258806,{S[7388-7386];u,S[874125-874122],S[391297+-391293],D})u=y(u)M=V[w]D=y(D)w=.04 V=M(w,R)V={}M=T[Z(-620694+558375)]end end else if M&lt;-556408+17207743 then if M&lt;16882738-239836 then if M&lt;16904726-312057 then c=683372+29367699539967 M=x[S[-606939-(-606940)]]P=Z(695139+-757171)u=x[S[140465-140463]]Y=x[S[394944-394941]]D=x[S[251025-251021]]R=D(P,c)w=Y[R]D=x[S[515314+-515309]]P=x[S[-135619+135621]]R={D(P)}Y={C(R)}V=M(u,w,Y)V={}M=T[Z(-161436-(-98852))]else M=D V=M(u,Y)Y=Z(-844159+782441)Q=32997737299139-(-48962)V=T[Y]D=x[S[-174171+174173]]R=x[S[-145346-(-145349)]]c=Z(42143-104554)P=R(c,Q)c=220655+30736626391545 Y=D[P]M=V[Y]Y=-641748-(-641750)V=M(Y)P=Z(-359414-(-296881))Y=x[S[-61550+61552]]D=x[S[558583-558580]]R=D(P,c)V=Y[R]M=u[V]M=M and 5868812-(-880434)or 14460285-(-600983)end else w,R=Y(u,w)M=w and 819138+13282746 or 4393915-(-782269)end else if M&lt;504523+16171088 then M=T[Z(-1055377-(-992802))]V={w}else w,R=Y(u,w)M=w and 13579319-(-593832)or 7586335-73580 end end end end end end end end end end M=#O return C(V)end,function(T,Z)local C=Y(Z)local H=function(H,S,O,h)return M(T,{H;S;O,h},Z,C)end return H end,function(T,Z)local C=Y(Z)local H=function(H,S,O,h,V,x,u)return M(T,{H,S,O,h;V;x,u},Z,C)end return H end,function(T,Z)local C=Y(Z)local H=function()return M(T,{},Z,C)end return H end,function(T)for Z=330494-330493,#T,-23868-(-23869)do u[T[Z]]=(-221028-(-221029))+u[T[Z]]end if H then local M=H(true)local C=O(M)C[Z(-493126-(-430818))],C[Z(732135+-794285)],C[Z(-818607-(-756960))]=T,D,function()return-352074-(-466871)end return M else return S({},{[Z(93307+-155457)]=D,[Z(462519-524827)]=T;[Z(-958313+896666)]=function()return-102852-(-217649)end})end end,function(T)u[T]=u[T]-(508840+-508839)if-174320-(-174320)==u[T]then u[T],x[T]=nil,nil end end,function(T,Z)local C=Y(Z)local H=function(...)return M(T,{...},Z,C)end return H end,function(T,Z)local C=Y(Z)local H=function(H)return M(T,{H},Z,C)end return H end,function(T,Z)local C=Y(Z)local H=function(H,S,O,h,V,x)return M(T,{H;S,O;h;V;x},Z,C)end return H end,function(T,Z)local C=Y(Z)local H=function(H,S,O,h,V,x,u,b)return M(T,{H;S,O,h,V;x;u;b},Z,C)end return H end,-48415-(-48415),function(T,Z)local C=Y(Z)local H=function(H,S,O,h,V)return M(T,{H;S,O;h;V},Z,C)end return H end,{},function()w=(-945245-(-945246))+w u[w]=61480-61479 return w end,{}return(R(12952074-(-772300),{}))(C(V))end)(getfenv and getfenv()or _ENV,unpack or table[Z(-923007+860795)],newproxy,setmetatable,getmetatable,select,{...})end)(...)</string>
